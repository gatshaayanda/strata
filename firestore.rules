rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['owner', 'staff', 'Owner', 'Staff'];
    }

    match /admins/{uid} {
      // Users may read only their own role document. Provision roles manually in Firebase Console.
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }

    match /strataMenu/{menuItemId} {
      function validMenuItem() {
        return request.resource.data.keys().hasOnly(['name', 'description', 'price', 'active', 'sortOrder', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'description', 'price', 'active', 'sortOrder', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 240
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.price <= 10000
          && request.resource.data.active is bool
          && request.resource.data.sortOrder is int
          && request.resource.data.updatedAt is string;
      }
      // Menu data is public storefront content; only authenticated Strata staff can mutate it.
      allow read: if true;
      allow create, update: if isAdmin() && validMenuItem();
      allow delete: if isAdmin();
    }

    match /orderRequests/{requestId} {
      function validNewOrderRequest() {
        return request.resource.data.keys().hasOnly([
          'customerId', 'customerName', 'phone', 'city', 'fulfilment',
          'itemsText', 'deliveryLocation', 'notes', 'status', 'source',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerId', 'customerName', 'city', 'fulfilment',
          'itemsText', 'deliveryLocation', 'notes', 'status', 'source',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && (
          !request.resource.data.keys().hasAny(['phone'])
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40)
        )
        && request.resource.data.city in ['Gaborone', 'Francistown']
        && request.resource.data.fulfilment in ['Delivery', 'Pickup', 'Need help deciding']
        && request.resource.data.itemsText is string
        && request.resource.data.itemsText.size() >= 3
        && request.resource.data.itemsText.size() <= 1200
        && request.resource.data.deliveryLocation is string
        && request.resource.data.deliveryLocation.size() <= 240
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 600
        && request.resource.data.status == 'New'
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      }

      allow create: if signedIn() && !isAdmin() && validNewOrderRequest();

      // A customer can read only their own requests. Admin queries must be authenticated and role-checked.
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      // Customers cannot change status or delete records. Staff may update only status/message/timestamp.
      allow update: if isAdmin()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'staffNote', 'updatedAt'])
        && request.resource.data.status in [
          'New', 'Received', 'Confirmed', 'Preparing',
          'Ready for pickup', 'Out for delivery', 'Completed', 'Cancelled'
        ]
        && request.resource.data.updatedAt is string
        && (
          !request.resource.data.keys().hasAny(['staffNote'])
          || (request.resource.data.staffNote is string && request.resource.data.staffNote.size() <= 1000)
        );

      allow delete: if false;
    }

    // Strata has no client-side access to any other Firestore collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
