# Copy to .env.local for local testing, or configure the same values in Vercel.
# These are public Firebase Web App configuration values, not Admin SDK secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=strata-6706b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id

# Optional: used to generate absolute metadata URLs.
# NEXT_PUBLIC_BASE_URL=https://your-actual-domain.example
